%include mdl.mki

VendorApiContextDir = $(BuildContext)VendorAPI/v8serial/
SourceIncludeDir    = $(_MakeFilePath)include/
LicenseFile         = $(_MakeFilePath)LICENSE

$(BuildContext)Delivery/v8serial-license.txt : $(LicenseFile)
    $(LinkFirstDepToFirstTarget)

$(VendorApiContextDir) : $(SourceIncludeDir)v8serial
    $(LinkFirstDepToFirstTargetAsDirectory)
