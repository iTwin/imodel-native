#---------------------------------------------------------------------------------------------
# pugixml.mke - Build iTwinPugixml from our BePugiXml wrapper + the vcpkg-built pugixml archive.
#
# Upstream pugixml is no longer compiled file-by-file from a checked-in source tree. vcpkg
# builds it (static triplet on every platform; see ../vcpkg.mki and ./vcpkg.json / overlay-ports)
# and this makefile combines that archive with our own BePugiXml.o wrapper into the deliverable
# downstream code expects:
#
#   * Static delivery: merge BePugiXml.o + vcpkg's libpugixml archive into one libiTwinPugixml
#     static archive (consumed as a thin-archive input by imodeljs.node).
#   * Dynamic delivery: link iTwinPugixml (shared lib + import lib) from BePugiXml.o + vcpkg's
#     libpugixml archive via the standard dlmlink machinery (linkLibrary.mki).
#
# The pugi:: export surface is preserved by the dllexport annotation injected into the vcpkg
# pugiconfig.hpp (see overlay-ports/pugixml/portfile.cmake); the wrapper symbols are exported
# via BEPUGIXML_EXPORT. No .def is involved.
#---------------------------------------------------------------------------------------------
BUILD_WITH_C20=1

%include mdl.mki

cDefs +% -D__PUGIXML_BUILD__

baseDir   = $(_MakeFilePath)
srcDir    = $(baseDir)src/
libsrcDir = $(baseDir)../
o = $(PartBuildDir)

appName = iTwinPugixml
CCompPDBName = $(appName)

#Ignore unknown pragmas (i.e. pragma mark)
LLVMCommonCompOpts  + -Wno-unknown-pragmas

#--------------------------------------------------------------------------------------
#   Resolve the vcpkg triplet and install root. The vcpkg_install_pugixml chain part always
#   runs as Static, so the installed packages live under the static OutputRootDir. Both static
#   and dynamic builds of this mke point vcpkgInstallRoot at that same location; no second
#   vcpkg invocation is needed.
#--------------------------------------------------------------------------------------
%include $(libsrcDir)vcpkg.mki
%if defined (CREATE_STATIC_LIBRARIES)
vcpkgInstallRoot = $(OutputRootDir)vcpkg_installed/pugixml/
%else
vcpkgInstallRoot = $(OutputRootDir)static/vcpkg_installed/pugixml/
%endif
vcpkgTripletDir = $(vcpkgInstallRoot)$(vcpkgTriplet)/
vcpkgLibDir     = $(vcpkgTripletDir)lib/
vcpkgDbgLibDir  = $(vcpkgTripletDir)debug/lib/

#--------------------------------------------------------------------------------------
#   Resolve the vcpkg-produced pugixml static archive (single translation unit, so the whole
#   object is pulled in whenever any pugi symbol is referenced). Release and debug share the
#   same file name and differ only by directory.
#--------------------------------------------------------------------------------------
%if $(TARGET_PLATFORM) == "Windows"
    pugixmlLibName = pugixml.lib
%else
    pugixmlLibName = libpugixml.a
%endif

%if defined (DEBUG)
    vcpkgPugixml = $(vcpkgDbgLibDir)$(pugixmlLibName)
%else
    vcpkgPugixml = $(vcpkgLibDir)$(pugixmlLibName)
%endif

always:
    !~@mkdir $(o)

#--------------------------------------------------------------------------------------
#   Compile our Bentley wrapper (the only source we still own; vcpkg builds pugixml.cpp).
#--------------------------------------------------------------------------------------
MultiCompileDepends=$(_MakeFileSpec)
%include MultiCppCompileRule.mki

BePugiXmlHeaders =              $(srcDir)BePugiXml.h

$(o)BePugiXml$(oext) : $(srcDir)BePugiXml.cpp $(BePugiXmlHeaders) ${MultiCompileDepends}

%include MultiCppCompileGo.mki
cppObjects=%$(MultiCompileObjectList)

#--------------------------------------------------------------------------------------
#   Produce the iTwinPugixml deliverable.
#--------------------------------------------------------------------------------------
%if defined (CREATE_STATIC_LIBRARIES)

    #----------------------------------------------------------------------------------
    #   Static delivery: merge BePugiXml.o + vcpkg's libpugixml archive into one archive.
    #   macOS/iOS use libtool, Linux/Android use ar (via merge_static_libs.sh / ar qcL),
    #   Windows-static uses lib.exe.
    #----------------------------------------------------------------------------------
    pugixmlStaticOut = $(o)$(stlibprefix)$(appName)$(stlibext)

    always:
        -$(deleteCmd) "$(pugixmlStaticOut)"
    %if $(TARGET_PLATFORM) == "Windows"
        lib "-OUT:$(pugixmlStaticOut)" $(cppObjects) "$(vcpkgPugixml)"
    %elif $(TARGET_PLATFORM) == "MacOS" || $(TARGET_PLATFORM) == "iOS"
        libtool -static -o "$(pugixmlStaticOut)" $(cppObjects) "$(vcpkgPugixml)"
    %elif $(TARGET_PLATFORM) == "Linux"
        $(libsrcDir)merge_static_libs.sh "$(pugixmlStaticOut)" $(cppObjects) "$(vcpkgPugixml)"
    %elif $(TARGET_PLATFORM) == "Android"
        $(BENTLEY_ANDROID_TOOLCHAIN_ar) qcL "$(pugixmlStaticOut)" $(cppObjects) "$(vcpkgPugixml)"
    %endif

    always:
        -$(deleteCmd) "$(BuildContext)Delivery/$(stlibprefix)$(appName)$(stlibext)"
        ~linkfile "$(BuildContext)Delivery/$(stlibprefix)$(appName)$(stlibext)=$(pugixmlStaticOut)"

%else

    #----------------------------------------------------------------------------------
    #   Dynamic delivery: link the shared lib + import lib from BePugiXml.o + vcpkg's
    #   libpugixml archive. Reuses the standard dlmlink machinery so versioning, signing,
    #   the import library, and BuildContext delivery behave exactly as before. The pugi API
    #   is re-exported via the dllexport annotations baked into the vcpkg archive on Windows
    #   (default visibility elsewhere); the wrapper symbols via BEPUGIXML_EXPORT. No .def.
    #----------------------------------------------------------------------------------
    DLM_NAME            = $(appName)
    DLM_DEST            = $(o)
    DLM_OBJECT_FILES    = $(cppObjects) $(vcpkgPugixml)
    DLM_EXPORT_DEST     = $(o)
    DLM_NOINITFUNC      = 1
    DLM_NOENTRY         = 1
    DLM_OBJECT_DEST     = $(o)

    LINKER_LIBRARIES + $(BuildContext)SubParts/Libs/$(libprefix)iTwinBentley$(stlibext)

    %include $(sharedMki)linkLibrary.mki

%endif
