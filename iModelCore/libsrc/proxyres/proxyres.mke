%include mdl.mki

o = $(OutputRootDir)build/proxyres/
vendorSrc = $(_MakeFilePath)vendor/

%if $(TARGET_PLATFORM)=="Windows"
    %if defined (DEBUG)
        configDir=Debug/
    %else
        configDir=Release/
    %endif
%elif $(TARGET_PLATFORM)=="iOS"
    %if defined (DEBUG)
        configDir=Debug-iphoneos/
    %else
        configDir=Release-iphoneos/
    %endif
%else
    configDir=
%endif

always:
    !~@mkdir $(o)

%if defined (DEBUG)
    CMAKE_BUILD_TYPE=Debug
%else
    CMAKE_BUILD_TYPE=Release
%endif

# bmake links the release CRT even in DEBUG builds, so force cmake's Debug config onto /MD;
# otherwise proxyres.lib carries a /DEFAULTLIB:MSVCRTD directive that fails links which do not
# pass -NODEFAULTLIB:msvcrtd.lib (LNK4098 -> LNK1218), such as the gtest executables.
# CMAKE_MSVC_RUNTIME_LIBRARY is honored only under CMP0091 NEW, and proxyres's vendored
# CMakeLists pins cmake_minimum_required(3.12), so the policy has to be defaulted explicitly.
%if $(TARGET_PLATFORM)=="Windows"
    CMAKE_CRT_OPTIONS=-DCMAKE_POLICY_DEFAULT_CMP0091=NEW -DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreadedDLL
%else
    CMAKE_CRT_OPTIONS=
%endif

%if $(TARGET_PLATFORM)=="MacOS"
    CMAKE_APPLE_OPTIONS=-DCMAKE_OSX_DEPLOYMENT_TARGET=$(MACOS_DEPLOYMENT_TARGET)
%elif $(TARGET_PLATFORM)=="iOS"
    CMAKE_APPLE_OPTIONS=-DDEPLOYMENT_TARGET=$(IOS_DEPLOYMENT_TARGET)
%else
    CMAKE_APPLE_OPTIONS=
%endif

$(o)$(libprefix)proxyres$(libext) :
    ~chdir $(vendorSrc)
    %if $(TARGET_PLATFORM)=="iOS"
        cmake -S . -G Xcode \
            -DCMAKE_TOOLCHAIN_FILE=../../ios-cmake/ios.toolchain.cmake \
            -DPLATFORM=OS64 \
            ${CMAKE_APPLE_OPTIONS} \
            -DPROXYRES_BUILD_CLI=OFF \
            -DPROXYRES_BUILD_TESTS=OFF \
            -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE} \
            -B $(o)
        cmake --build $(o) --config ${CMAKE_BUILD_TYPE}
    %else
        cmake -S . \
            -DPROXYRES_BUILD_CLI=OFF \
            -DPROXYRES_BUILD_TESTS=OFF \
            -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE} \
            ${CMAKE_CRT_OPTIONS} \
            ${CMAKE_APPLE_OPTIONS} \
            -B $(o)
        cmake --build $(o) --config ${CMAKE_BUILD_TYPE}
    %endif

# Vendor API
always:
    ~linkdir "$(BuildContext)VendorAPI/proxyres=$(vendorSrc)/include/proxyres"

$(BuildContext)Delivery/$(stlibprefix)proxyres$(stlibext) : $(o)$(configDir)$(stlibprefix)proxyres$(stlibext)
    $(LinkFirstDepToFirstTarget)

$(BuildContext)Delivery/proxyres-license.txt : $(vendorSrc)LICENSE.md
    $(LinkFirstDepToFirstTarget)

$(BuildContext)Delivery/ios-cmake-license.txt : $(_MakeFilePath)../ios-cmake/LICENSE.md
    $(LinkFirstDepToFirstTarget)
