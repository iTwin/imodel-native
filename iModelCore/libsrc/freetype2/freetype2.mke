#---------------------------------------------------------------------------------------------
# freetype2.mke - Build FreeType via vcpkg and deliver it as iTwinFreetype2.
#
# FreeType is no longer compiled file-by-file from a checked-in source tree. vcpkg builds it
# (static triplet on every platform; see ../vcpkg.mki and ./vcpkg.json) and this makefile
# re-packages the result into the deliverables downstream code expects:
#
#   * Static delivery (all platforms): vcpkg produces a single freetype archive, so it is
#     delivered directly under the iTwinFreetype2 name. zlib is NOT merged in -- BeZlib provides
#     those symbols at the final link.
#   * Dynamic delivery (Windows only): re-link iTwinFreetype2.dll + its import library from
#     vcpkg's static freetype.lib, applying an export .def generated from FreeType's public
#     headers (the static Windows build does not define DLL_EXPORT, so the archive carries no
#     dllexport information).
#
# Headers and the license notice are staged by freetype2.prewire.mke.
#---------------------------------------------------------------------------------------------

IS_THIRD_PARTY_LIBRARY = 1

%include mdl.mki

%if defined(iTwinNativeThirdParty)
    appName = freetype2
%else
    appName = iTwinFreetype2
%endif

freetype2Dir = $(_MakeFilePath)
libsrcDir    = $(freetype2Dir)../

o = $(OutBuildDir)$(appName)/

#--------------------------------------------------------------------------------------
#   Determine vcpkg triplet from TARGET_PROCESSOR_ARCHITECTURE
#--------------------------------------------------------------------------------------
# This library's triplets set no explicit -RTC flags, so no veracode overlay triplet is
# needed and vcpkgUseVeracodeTriplet is intentionally left undefined.
%include $(libsrcDir)vcpkg.mki

# The vcpkg install chain always runs static-only, so the packages always live under the
# static OutputRootDir. Static builds of this part share that root directly; dynamic builds
# (whose OutputRootDir omits the "static/" segment) must redirect to the same static location.
%if defined (CREATE_STATIC_LIBRARIES)
vcpkgInstallRoot = $(OutputRootDir)vcpkg_installed/freetype2/
%else
vcpkgInstallRoot = $(OutputRootDir)static/vcpkg_installed/freetype2/
%endif
vcpkgTripletDir  = $(vcpkgInstallRoot)$(vcpkgTriplet)/
vcpkgIncludeDir  = $(vcpkgTripletDir)include/
vcpkgLibDir      = $(vcpkgTripletDir)lib/
vcpkgDbgLibDir   = $(vcpkgTripletDir)debug/lib/

always:
    !~@mkdir $(o)

#--------------------------------------------------------------------------------------
#   Resolve the vcpkg-produced static archive. FreeType's CMakeLists.txt sets
#   CMAKE_DEBUG_POSTFIX to "d" on every platform, so the debug archive is freetyped.
#   The Windows debug archive is built against the debug CRT but uses no debug-CRT-only
#   functionality, so it links into our release-CRT DEBUG builds as-is (see the vcpkg skill's
#   "Windows DEBUG" section); no release-only or CRT fix-up is needed.
#--------------------------------------------------------------------------------------
%if defined (DEBUG)
    freetypeStem = freetyped
%else
    freetypeStem = freetype
%endif

%if $(TARGET_PLATFORM) == "Windows"
    freetypeLibName = $(freetypeStem).lib
%else
    freetypeLibName = lib$(freetypeStem).a
%endif

%if defined (DEBUG)
    vcpkgFreetype = $(vcpkgDbgLibDir)$(freetypeLibName)
%else
    vcpkgFreetype = $(vcpkgLibDir)$(freetypeLibName)
%endif

#--------------------------------------------------------------------------------------
#   Produce the iTwinFreetype2 deliverable.
#--------------------------------------------------------------------------------------
%if defined (CREATE_STATIC_LIBRARIES)

    always:
        ~linkfile "$(BuildContext)Delivery/$(stlibprefix)$(appName)$(stlibext)=$(vcpkgFreetype)"

%else

    #----------------------------------------------------------------------------------
    #   Dynamic delivery (Windows only): generate an export .def from FreeType's public headers,
    #   then re-link iTwinFreetype2.dll + import lib from the vcpkg static freetype.lib. Reuses
    #   the standard dlmlink machinery (via linkLibrary.mki) so versioning, signing, the import
    #   library, and BuildContext delivery behave as before. link.exe pulls the exported objects
    #   out of the static .lib as directed by the .def.
    #
    #   The .def is regenerated on every build because its content comes from the vcpkg-installed
    #   headers, whose timestamps are not a reliable prerequisite (a binary-cache hit can restore
    #   older ones). makeFreetypeDef.py embeds the linked archive's SHA-256 and rewrites the file
    #   only when the exports or archive contents change. The dlmlink machinery consumes
    #   DLM_MODULE_DEF as a linker option rather than as a prerequisite of the DLL, so changed
    #   inputs cause makeFreetypeDef.py to delete the previously linked DLL before writing the .def.
    #   This forces a re-link even when the restored archive's timestamp predates the DLL.
    #----------------------------------------------------------------------------------
    always:
        $(BBPYTHONCMD) $(freetype2Dir)makeFreetypeDef.py "$(vcpkgIncludeDir)freetype" "$(o)$(appName).def" "$(vcpkgFreetype)" "$(o)$(shlibprefix)$(appName)$(shlibext)"

    DLM_NAME                    = $(appName)
    DLM_OBJECT_FILES            = $(vcpkgFreetype)
    DLM_EXPORT_OBJS             = $(DLM_OBJECT_FILES)
    DLM_OBJECT_DEST             = $(o)
    DLM_DEST                    = $(o)
    DLM_EXPORT_DEST             = $(o)
    DLM_NOENTRY                 = 1
    DLM_NO_BENTLEY_LIB          = 1
    DLM_CONTEXT_LOCATION        = $(BuildContext)Delivery/
    DLM_LIB_CONTEXT_LOCATION    = $(BuildContext)Delivery/
    DLM_CREATE_LIB_CONTEXT_LINK = 1
    DLM_MODULE_DEF              = $(o)$(appName).def

    # BeZlib resolves FreeType's zlib references (the vcpkg zlib archive is not linked).
    LINKER_LIBRARIES = $(ContextSubPartsStaticLibs)$(libprefix)BeZlib$(libext)

    # DLM_NOENTRY suppresses the Bentley DLL entry-point object that would normally carry
    # /DEFAULTLIB directives into the link, so list the CRT import libs explicitly (mirrors
    # BeCurl.mke). Listing the release CRT explicitly also keeps the debug archive's
    # /DEFAULTLIB:MSVCRTD from pulling the debug CRT into DEBUG builds.
    LINKER_LIBRARIES + $(cRuntime)
    LINKER_LIBRARIES + vcruntime.lib
    LINKER_LIBRARIES + ucrt.lib

    %include $(sharedMki)linkLibrary.mki

%endif
