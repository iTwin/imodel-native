#---------------------------------------------------------------------------------------------
# vcpkg_validate_mend.mke - Check every vcpkg consumer's Mend scan configuration.
# This downloads nothing; it only reads the manifests, so it is cheap enough to gate the head of
# the vcpkg install chain.  Without it the only thing that reads vcpkg-mend.json is the Mend
# pipeline, so a missing or malformed file would not surface until long after the PR merged.
#---------------------------------------------------------------------------------------------

%include mdl.mki

always:
    powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$(_MakeFilePath)vcpkg_download_mend_sources.ps1" -ValidateOnly
