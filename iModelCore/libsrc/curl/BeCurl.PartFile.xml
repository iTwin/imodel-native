<?xml version="1.0" encoding="utf-8"?>

<BuildContext xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="../../../../bentleybuild/PartFile.xsd"
              >

    <Part Name="BeCurl">
        <SubPart PartName="Library" />
    </Part>

    <!-- Bind my own VendorAPI into BuildContext/VendorAPI. Note that this part does not cause any sub-part VendorAPI to be bound. I also delivery my license notice. -->
    <Part Name="PublicAPI" BentleyBuildMakeFile="BeCurl.prewire.mke">
        <!-- LibType="Static": the chain runs static-only; the prewire stages curl headers from the
             static vcpkg install root. -->
        <SubPart PartName="vcpkg_install_curl" PartFile="iModelCore/libsrc/vcpkg" LibType="Static"/>
        <SubPart PartName="CAresNotice" LibType="Static"/>
        <Bindings>
            <VendorAPI Domain="curl" />
            <VendorNotices>Delivery/curl-license.txt</VendorNotices>
        </Bindings>
    </Part>

    <!-- OnlyPlatforms: vcpkg only installs c-ares on macOS/Linux (see vcpkg.json), which are also
         the only platforms that merge it into iTwinCurl, so its notice exists (and is only
         required) there. -->
    <Part Name="CAresNotice" BentleyBuildMakeFile="BeCares.prewire.mke" OnlyPlatforms="linux*,macos*">
        <!-- LibType="Static": the chain runs static-only; the notice comes from the static vcpkg
             install root. -->
        <SubPart PartName="vcpkg_install_curl" PartFile="iModelCore/libsrc/vcpkg" LibType="Static"/>
        <Bindings>
            <VendorNotices>Delivery/c-ares-license.txt</VendorNotices>
        </Bindings>
    </Part>

    <!-- NOTE: Graphite uses "G" as a library suffix to disambiguate from Vancouver libraries -->
    <Part Name="Library" BentleyBuildMakeFile="BeCurl.mke">
        <!-- LibType="Static": the vcpkg install (and thus the prewire that stages headers from it)
             runs static-only, writing under the static OutputRootDir.  Pulling PublicAPI as Static
             here forces the prewire to run in the static flavor too, so its $(OutputRootDir) matches
             the install root even when Library is built dynamic (BeCurlDynamic / iTwinCurl.dll).
             Without this the dynamic prewire looks under Winx64\ instead of Winx64\static\ and fails
             with "cannot create link ... VendorAPI\curl ... desired target does not exist". -->
        <SubPart PartName="PublicAPI" LibType="Static"/>
        <!-- LibType="Static": the chain is static-only; BeCurl.mke reads the vcpkg-built curl (+ c-ares)
             archives from the static install root for both static and dynamic builds. -->
        <SubPart PartName="vcpkg_install_curl" PartFile="iModelCore/libsrc/vcpkg" LibType="Static"/>
        <SubPart LibType="Static" PartName="Compress" PartFile="iModelCore\libsrc\compress\Zlib"/>
        <SubPart PartName="Library" PartFile="iModelCore\libsrc\openssl\BeOpenSSL"/>
        <Bindings>
            <Libs>Delivery/$(libprefix)iTwinCurl$(libext)</Libs>
            <Assemblies>Delivery/$(shlibprefix)iTwinCurl$(shlibext)</Assemblies>
        </Bindings>
    </Part>

    <Part Name="BeCurlDynamic" ExcludePlatforms="Android*,iOS*,Linux*,MacOS*">
        <SubPart PartName="BeCurl" LibType="Dynamic"/>
    </Part>
    
    <Part Name="BeCurlStatic">
        <SubPart PartName="BeCurl" LibType="Static"/>
    </Part>

    <NuGetProduct Name="CurlNuget" LicenseFile="CurlNugetLicense.json">
        <Directories DirectoryListName="ForSdkSource" PartFile="CommonProductDirs" Repository="bsicommon"/>
        <Directories DirectoryListName="NugetSdkSourceOverride" PartFile="CommonProductDirs" Repository="bsicommon"/>
        <SubPart PartName="BeCurlDynamic"/>
        <SubPart PartName="BeCurlStatic"/>
    </NuGetProduct>

</BuildContext>
