#---------------------------------------------------------------------------------------------
# BeCurl.prewire.mke - Stage curl public headers and license notices from the vcpkg build so the
# PublicAPI part's VendorAPI/VendorNotices bindings are satisfied at the PublicAPI stage.
#
# Headers no longer come from a checked-in vendor/ tree; vcpkg owns the curl source. The vcpkg
# install is performed by the vcpkg_install_curl part (vcpkg.PartFile.xml) before this mke runs,
# so include/curl/*.h and the license are already present.
#---------------------------------------------------------------------------------------------
%include mdl.mki

curlDir   = $(_MakeFilePath)
libsrcDir = $(curlDir)../

o = $(OutputRootDir)build/iTwinCurl-prewire/

# Mirror the triplet override from BeCurl.mke so the prewire reads the same vcpkg_installed tree.
%if $(TARGET_PROCESSOR_ARCHITECTURE) == "x64"
    vcpkgWindowsMDCRT = 1
%endif
%include $(libsrcDir)vcpkg.mki

vcpkgInstallRoot = $(OutputRootDir)vcpkg_installed/curl/
vcpkgTripletDir  = $(vcpkgInstallRoot)$(vcpkgTriplet)/
vcpkgIncludeDir  = $(vcpkgTripletDir)include/

always:
    !~@mkdir $(o)

#--------------------------------------------------------------------------------------
#   Deliver headers (VendorAPI/curl -> vcpkg include/curl) and the license notices.
#   curl's copyright comes from the vcpkg tree; the c-ares notice still comes from the vendored
#   ares/ tree (delivered on every platform even though c-ares is only linked on macOS/Linux).
#   TODO(cleanup): when ares/ is removed, source the c-ares notice from a checked-in copy or from
#   the vcpkg share/c-ares/copyright (present only on macOS/Linux).
#--------------------------------------------------------------------------------------
always:
    ~linkdir "$(BuildContext)VendorAPI/curl=$(vcpkgIncludeDir)curl/"
    ~linkfile "$(BuildContext)Delivery/curl-license.txt=$(vcpkgTripletDir)share/curl/copyright"
    ~linkfile "$(BuildContext)Delivery/c-ares-license.md=$(curlDir)ares/LICENSE.md"
