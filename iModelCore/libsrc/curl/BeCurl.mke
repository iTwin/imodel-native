#---------------------------------------------------------------------------------------------
# BeCurl.mke - Build curl (+ c-ares) via vcpkg and deliver it as iTwinCurl.
#
# curl is no longer compiled file-by-file from a checked-in source tree. vcpkg builds it (static
# triplet on every platform; see ../vcpkg.mki and ./vcpkg.json) and this makefile re-packages the
# result into the deliverables downstream code expects:
#
#   * Static delivery (all platforms): merge vcpkg's libcurl (and, on macOS/Linux, libcares)
#     static archives into a single iTwinCurl archive. openssl and zlib are NOT merged in --
#     iTwinOpenSSL and BeZlib provide those symbols at the final imodeljs.node link.
#   * Dynamic delivery (Windows only): re-link iTwinCurl.dll + its import library from vcpkg's
#     static libcurl.lib, applying an export .def generated from curl's public headers (the static
#     Windows triplet defines CURL_STATICLIB, so the archive carries no dllexport information).
#
# TLS backends: schannel on Windows, OpenSSL + Apple SecTrust on macOS/iOS (USE_APPLE_SECTRUST is
# set in the Apple triplets), OpenSSL on Linux/Android. The Apple Security/CoreFoundation/
# CoreServices frameworks are linked by the addon (IModelJsNative.mke), not here.
#---------------------------------------------------------------------------------------------

IS_THIRD_PARTY_LIBRARY = 1

%include mdl.mki

%if defined(iTwinNativeThirdParty)
    appName = BeCurl
%else
    appName = iTwinCurl
%endif

curlDir   = $(_MakeFilePath)
libsrcDir = $(curlDir)../

o = $(OutputRootDir)build/$(appName)/

#--------------------------------------------------------------------------------------
#   Determine vcpkg triplet. On Windows, iTwinCurl.dll is re-linked /MD and links iTwinOpenSSL.dll
#   (also /MD), so request the x64-windows-static-md triplet (mirrors BeOpenSSL / the install mke).
#--------------------------------------------------------------------------------------
%if $(TARGET_PROCESSOR_ARCHITECTURE) == "x64"
    vcpkgWindowsMDCRT = 1
%endif
%include $(libsrcDir)vcpkg.mki

# The vcpkg_install_curl chain part always runs as Static, so the installed packages live under
# the static OutputRootDir. Both static and dynamic builds of this mke point vcpkgInstallRoot at
# that same location so no second vcpkg invocation is needed.
%if defined (CREATE_STATIC_LIBRARIES)
vcpkgInstallRoot = $(OutputRootDir)vcpkg_installed/curl/
%else
vcpkgInstallRoot = $(OutputRootDir)static/vcpkg_installed/curl/
%endif
vcpkgTripletDir  = $(vcpkgInstallRoot)$(vcpkgTriplet)/
vcpkgIncludeDir  = $(vcpkgTripletDir)include/
vcpkgLibDir      = $(vcpkgTripletDir)lib/
vcpkgDbgLibDir   = $(vcpkgTripletDir)debug/lib/

always:
    !~@mkdir $(o)

#--------------------------------------------------------------------------------------
#   Resolve the vcpkg-produced static libraries. c-ares is only built (and only linked) on
#   macOS and Linux; the other platforms use curl's threaded resolver, so no libcares there.
#--------------------------------------------------------------------------------------
%if $(TARGET_PLATFORM) == "Windows"
    libcurlName = libcurl.lib
%else
    libcurlName = libcurl.a
%endif
libcaresName = libcares.a

%if defined (DEBUG)
    vcpkgCurl  = $(vcpkgDbgLibDir)$(libcurlName)
    vcpkgCares = $(vcpkgDbgLibDir)$(libcaresName)
%else
    vcpkgCurl  = $(vcpkgLibDir)$(libcurlName)
    vcpkgCares = $(vcpkgLibDir)$(libcaresName)
%endif

# Only macOS/Linux bundle c-ares; blank it elsewhere so the merge lists only libcurl.
%if $(TARGET_PLATFORM) != "MacOS" && $(TARGET_PLATFORM) != "Linux"
    vcpkgCares =
%endif

#--------------------------------------------------------------------------------------
#   Produce the iTwinCurl deliverable.
#--------------------------------------------------------------------------------------
%if defined (CREATE_STATIC_LIBRARIES)

    #----------------------------------------------------------------------------------
    #   Static delivery (all platforms): merge libcurl (+ libcares on macOS/Linux) into one
    #   archive. macOS/iOS use libtool, Linux uses the shared merge_static_libs.sh (ar), Android
    #   uses the NDK ar, Windows-static uses lib.exe.
    #----------------------------------------------------------------------------------
    curlStaticOut = $(o)$(stlibprefix)$(appName)$(stlibext)

    always:
        -$(deleteCmd) "$(curlStaticOut)"
    %if $(TARGET_PLATFORM) == "Windows"
        lib "-OUT:$(curlStaticOut)" "$(vcpkgCurl)"
    %elif $(TARGET_PLATFORM) == "MacOS" || $(TARGET_PLATFORM) == "iOS"
        libtool -static -o "$(curlStaticOut)" "$(vcpkgCurl)" $(vcpkgCares)
    %elif $(TARGET_PLATFORM) == "Linux"
        $(libsrcDir)merge_static_libs.sh "$(curlStaticOut)" "$(vcpkgCurl)" $(vcpkgCares)
    %elif $(TARGET_PLATFORM) == "Android"
        $(BENTLEY_ANDROID_TOOLCHAIN_ar) qcL "$(curlStaticOut)" "$(vcpkgCurl)"
    %endif

    always:
        -$(deleteCmd) "$(BuildContext)Delivery/$(stlibprefix)$(appName)$(stlibext)"
        ~linkfile "$(BuildContext)Delivery/$(stlibprefix)$(appName)$(stlibext)=$(curlStaticOut)"

%else

    #----------------------------------------------------------------------------------
    #   Dynamic delivery (Windows only): generate an export .def from curl's public headers, then
    #   re-link iTwinCurl.dll + import lib from the vcpkg static libcurl.lib. Reuses the standard
    #   dlmlink machinery (via linkLibrary.mki) so versioning, signing, the import library, and
    #   BuildContext delivery behave as before. link.exe pulls the exported objects out of the
    #   static .lib as directed by the .def.
    #----------------------------------------------------------------------------------
    $(o)$(appName).def : $(curlDir)makeCurlDef.py
        $(BBPYTHONCMD) $(curlDir)makeCurlDef.py "$(vcpkgIncludeDir)curl" "$@"

    curlModuleDef = $(o)$(appName).def

    DLM_NAME                    = $(appName)
    DLM_OBJECT_FILES            = $(vcpkgCurl)
    DLM_EXPORT_OBJS             = $(DLM_OBJECT_FILES)
    DLM_OBJECT_DEST             = $(o)
    DLM_DEST                    = $(o)
    DLM_EXPORT_DEST             = $(o)
    DLM_NOENTRY                 = 1
    DLM_NO_BENTLEY_LIB          = 1
    DLM_CONTEXT_LOCATION        = $(BuildContext)Delivery/
    DLM_LIB_CONTEXT_LOCATION    = $(BuildContext)Delivery/
    DLM_CREATE_LIB_CONTEXT_LINK = 1
    DLM_MODULE_DEF              = $(curlModuleDef)

    # curl uses schannel on Windows (not openssl), but iTwinOpenSSL is linked to match the prior
    # build and is harmless if unreferenced. BeZlib resolves curl's zlib references.
    %if defined(iTwinNativeThirdParty)
        LINKER_LIBRARIES = $(BuildContext)SubParts/Libs/$(libprefix)BeOpenSSL$(libext)
    %else
        LINKER_LIBRARIES = $(BuildContext)SubParts/Libs/$(libprefix)iTwinOpenSSL$(libext)
    %endif
    LINKER_LIBRARIES + $(ContextSubPartsStaticLibs)$(libprefix)BeZlib$(libext)

    LINKER_LIBRARIES + ws2_32.lib
    LINKER_LIBRARIES + wldap32.lib
    LINKER_LIBRARIES + advapi32.lib
    LINKER_LIBRARIES + crypt32.lib
    LINKER_LIBRARIES + secur32.lib
    LINKER_LIBRARIES + Iphlpapi.lib
    LINKER_LIBRARIES + bcrypt.lib

    # DLM_NOENTRY suppresses the Bentley DLL entry-point object that would normally carry
    # /DEFAULTLIB directives into the link. The vcpkg archive emits none either, so list the CRT
    # import libs explicitly (mirrors BeOpenSSL.mke).
    LINKER_LIBRARIES + $(cRuntime)
    LINKER_LIBRARIES + vcruntime.lib
    LINKER_LIBRARIES + ucrt.lib

    %include $(sharedMki)linkLibrary.mki

%endif
