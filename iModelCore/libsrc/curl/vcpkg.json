{
  "name": "imodel-native-curl",
  "version": "1.0.0",
  "dependencies": [
    {
      "name": "curl",
      "version>=": "8.23.0",
      "default-features": false,
      "features": [
        "ssl"
      ]
    },
    {
      "name": "curl",
      "default-features": false,
      "features": [
        "c-ares"
      ],
      "platform": "osx | linux"
    }
  ],
  "overrides": [
    { "name": "curl", "version": "8.23.0" },
    { "name": "openssl", "version": "3.6.5" },
    { "name": "zlib", "version": "1.3.2#1" },
    { "name": "c-ares", "version": "1.34.8" }
  ]
}
